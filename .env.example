# ==========================================
# Matini — local LLM chat + NIST AI RMF assessment
# ==========================================

# Application General
APP_TITLE="Matini"
APP_ENV="development"
DEBUG=true
SECRET_KEY="replace-this-with-a-secure-random-key-in-production"

# FastAPI Backend Service
API_HOST="127.0.0.1"
API_PORT=8000
API_URL="http://127.0.0.1:8000"

# Flask Web Frontend Service
WEB_HOST="0.0.0.0"
WEB_PORT=8080

# MongoDB (database name comes from the URI path)
MONGODB_URI="mongodb://localhost:27017/matinidb"

# Ollama (default endpoint for new LLMs added on /admin, and for the assessment judge)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_JUDGE_MODEL="llama3.1"
OLLAMA_TIMEOUT_S=120
