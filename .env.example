# ==========================================
# Matini AI Registry & Guardrail Sandbox Config
# ==========================================

# Application General
APP_TITLE="Matini AI Registry"
APP_ENV="development"
DEBUG=true
SECRET_KEY="replace-this-with-a-secure-random-key-in-production"

# FastAPI Backend Service
API_HOST="127.0.0.1"
API_PORT=8000
API_URL="http://127.0.0.1:8000"

# Flask Web Frontend Service
WEB_HOST="0.0.0.0"
WEB_PORT=8080

# LLM Mocking & Performance Settings
MOCK_LLM_LATENCY_MIN=0.18
MOCK_LLM_LATENCY_MAX=0.32
